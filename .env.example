# Copy to .env.local (gitignored) and fill in.

# GitHub App's Client ID (public — fine to ship in the bundle).
# See worker/README.md for App setup. Tokens are scoped to the
# repo(s) the App is installed on (theatrum), not all of the user's
# repos like OAuth Apps would be.
VITE_GITHUB_CLIENT_ID=

# URL of the deployed Cloudflare Worker doing the OAuth code-for-token exchange
VITE_OAUTH_WORKER_URL=

# GitHub repo for the move-PR target (owner/repo)
VITE_GITHUB_REPO=kgmyatthu/theatrum
